{
  "name": "biblioteca",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Biblioteca de prompts de Itskeo: cada video con el prompt exacto que lo generó.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && astro preview",
    "deploy": "astro build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply biblioteca --local",
    "ejemplos": "node scripts/ejemplos.mjs",
    "clave": "node scripts/clave.mjs",
    "tipos": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "astro": "^7.3.6",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "mediabunny": "^1.61.3"
  },
  "devDependencies": {
    "wrangler": "^4.148.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261006.1": true
  }
}
