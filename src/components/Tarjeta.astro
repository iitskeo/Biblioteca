---
import Icon from './Icon.astro';
import { aspecto, esHorizontal, media, vtName } from '../lib/site';
import type { Entrada } from '../lib/db';

interface Props {
  entrada: Entrada;
}

const { entrada } = Astro.props;
const { id, titulo, herramientas, video, poster, formato, prompts } = entrada;

// Texto de los prompts: de aquí sale el fragmento resaltado cuando alguien busca.
const texto = prompts.map((p) => p.texto).join('\n\n');
---

<li class:list={['tarjeta', { 'tarjeta--ancha': esHorizontal(formato) }]} data-id={id} data-texto={texto}>
  <a href={`/p/${id}/`} data-hover>
    <div class="tarjeta__media" style={`aspect-ratio: ${aspecto(formato)}; view-transition-name: ${vtName(id)}`}>
      <video data-play="hover" muted loop playsinline preload={poster ? 'none' : 'metadata'} poster={media(poster)} aria-hidden="true" tabindex="-1">
        <source src={media(video)} type="video/mp4" />
      </video>
    </div>
    <div class="tarjeta__info">
      <h3>{titulo}<Icon name="arrowUpRight" /></h3>
      {herramientas.length > 0 && <p class="tarjeta__hecho">{herramientas.join(' + ')}</p>}
      <p class="tarjeta__fragmento" data-fragmento hidden></p>
    </div>
  </a>
</li>

<style>
  .tarjeta[hidden] {
    display: none;
  }
  .tarjeta--ancha {
    grid-column: span 2;
  }
  a {
    display: block;
  }
  .tarjeta__media {
    position: relative;
    overflow: hidden;
    padding: var(--marco);
    border: 1px solid var(--marco-borde);
    border-radius: var(--radius);
    background: var(--surface);
    transition:
      transform 400ms var(--ease-out),
      border-color 200ms ease;
  }
  video {
    width: 100%;
    height: 100%;
    border-radius: calc(var(--radius) - var(--marco));
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }
  .tarjeta__info {
    padding: 14px 4px 0;
  }
  h3 {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--display);
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  h3 :global(.icon) {
    width: 0.95em;
    height: 0.95em;
    color: var(--accent);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition:
      opacity 200ms ease,
      transform 250ms var(--ease-out);
  }
  .tarjeta__hecho {
    margin-top: 2px;
    font-size: 0.875rem;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* Fragmento del prompt donde aparece lo que se buscó. */
  .tarjeta__fragmento {
    margin-top: 10px;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    background: var(--bg-2);
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--muted);
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tarjeta__fragmento[hidden] {
    display: none;
  }
  .tarjeta__fragmento :global(mark) {
    color: var(--text);
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover .tarjeta__media {
      transform: translateY(-4px);
    }
    a:hover .tarjeta__media {
      border-color: color-mix(in oklab, var(--accent) 45%, transparent);
    }
    a:hover h3 :global(.icon) {
      opacity: 1;
      transform: none;
    }
  }
  a:active .tarjeta__media {
    transform: scale(0.98);
    transition-duration: 160ms;
  }
  a:focus-visible {
    outline: none;
  }
  a:focus-visible .tarjeta__media {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    .tarjeta--ancha {
      grid-column: 1 / -1;
    }
    h3 {
      font-size: 1rem;
    }
  }
</style>
