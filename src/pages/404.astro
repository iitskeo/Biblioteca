---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base titulo="No encontrado">
  <section class="wrap perdido">
    <p class="mono">404</p>
    <h1>Este prompt no existe <span>o cambió de nombre.</span></h1>
    <a class="btn btn--primario" href="/#biblioteca"><Icon name="arrowLeft" /> Ir a la biblioteca</a>
  </section>
</Base>

<style>
  .perdido {
    display: grid;
    justify-items: start;
    gap: 24px;
    padding-block: clamp(64px, 12vw, 160px) 0;
  }
  .mono {
    color: var(--muted);
  }
  h1 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 620;
    letter-spacing: -0.045em;
    line-height: 1;
    max-width: 14ch;
  }
  h1 span {
    color: var(--muted);
  }
</style>
