---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Tarjeta from '../components/Tarjeta.astro';
import Paginacion from '../components/Paginacion.astro';
import { pagina, POR_PAGINA, recientes as buscarRecientes } from '../lib/db';
import { aspecto, esHorizontal, fecha, media } from '../lib/site';

// La biblioteca va en páginas de 24 (?pagina=2). Con ?q= viene filtrada.
// Los links de búsqueda y de página funcionan sin JavaScript; con JavaScript solo cambia la rejilla.
const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 120);
const numero = Math.max(1, Math.floor(Number(Astro.url.searchParams.get('pagina')) || 1));
const [[ultimo], todas, filtradas] = await Promise.all([
  buscarRecientes(1),
  pagina({ cantidad: q || numero > 1 ? 1 : undefined }),
  q || numero > 1 ? pagina({ q, desde: (numero - 1) * POR_PAGINA }) : null,
]);
const totalGeneral = todas.total;
let primera = filtradas ?? todas;
const totalPaginas = Math.max(1, Math.ceil(primera.total / POR_PAGINA));
// Página que ya no existe (se borraron prompts, link viejo): mostrar la última.
if (!primera.entradas.length && numero > totalPaginas) {
  primera = await pagina({ q, desde: (totalPaginas - 1) * POR_PAGINA });
}

const letras = [...'itskeo'];
---

<Base>
  <!-- Intro: la palabra entra letra por letra. Liviana: sin video ni librerías. -->
  <section class="intro">
    <div class="intro__escena">
      <p class="intro__palabra" aria-hidden="true">
        {
          letras.map((l, i) => (
            <span class="intro__letra" style={`--i: ${i}`}>
              <span>{l}</span>
            </span>
          ))
        }
      </p>

      <div class="intro__base wrap">
        <div class="intro__copy">
          <h1>Cada video, <span>con su prompt.</span></h1>
          <p>Aquí dejo los prompts exactos de mis videos. Cópialos, juega con ellos y etiquétame con lo que salga.</p>
        </div>
        <a class="btn btn--primario" href="#biblioteca">Ver prompts <Icon name="arrowDown" /></a>
      </div>
    </div>
  </section>

  {
    ultimo && (
      <section
        class:list={['reciente wrap', { 'reciente--ancho': esHorizontal(ultimo.formato) }]}
        aria-labelledby="reciente-titulo"
        data-revelar
      >
        <div class="reciente__texto">
          <h2 id="reciente-titulo">Lo más reciente</h2>
          <p class="reciente__fecha">
            <time datetime={ultimo.fecha}>{fecha(ultimo.fecha)}</time>
          </p>
          <h3 class="reciente__titulo">{ultimo.titulo}</h3>
          {ultimo.herramientas.length > 0 && <p class="reciente__hecho">Hecho con {ultimo.herramientas.join(' + ')}</p>}
          {ultimo.prompts[0] && <p class="reciente__prompt">{ultimo.prompts[0].texto}</p>}
          <a class="btn btn--primario" href={`/p/${ultimo.id}/`}>
            Ver el prompt <Icon name="arrowRight" />
          </a>
        </div>
        <a class="reciente__media" href={`/p/${ultimo.id}/`} style={`aspect-ratio: ${aspecto(ultimo.formato)}`} aria-label={`Ver ${ultimo.titulo}`}>
          <video data-play="auto" muted loop playsinline preload="metadata" poster={media(ultimo.poster)} aria-hidden="true" tabindex="-1">
            <source src={media(ultimo.video)} type="video/mp4" />
          </video>
        </a>
      </section>
    )
  }

  <section id="biblioteca" class="biblio wrap" aria-labelledby="biblio-titulo">
    <div class="biblio__cabeza" data-revelar>
      <h2 id="biblio-titulo">Todos los prompts <span class="conteo" data-conteo>{primera.total}</span></h2>

      {
        totalGeneral > 0 && (
          <div class="buscar">
            <label for="q">Busca dentro de los prompts</label>
            <div class="buscar__campo">
              <Icon name="search" />
              <input
                id="q"
                type="search"
                placeholder="nike, 16:9, neón…"
                autocomplete="off"
                spellcheck="false"
                enterkeyhint="search"
                aria-describedby="q-ayuda"
                value={q}
              />
            </div>
            <p id="q-ayuda" class="buscar__ayuda">
              Escribe cualquier palabra que esperas encontrar en el prompt: una marca, un estilo, una proporción.
            </p>
          </div>
        )
      }
    </div>

    {
      totalGeneral > 0 ? (
        <ul class="rejilla" data-rejilla data-pagina={Math.min(numero, totalPaginas)}>
          {primera.entradas.map((e) => (
            <Tarjeta entrada={e} />
          ))}
        </ul>
      ) : (
        <div class="vacio">
          <p class="vacio__titulo">Estoy preparando los primeros prompts.</p>
          <p>Mientras tanto, los videos ya están en TikTok.</p>
        </div>
      )
    }

    <div data-paginacion>
      <Paginacion actual={Math.min(numero, totalPaginas)} total={totalPaginas} q={q} />
    </div>

    <div class="vacio" data-vacio hidden={totalGeneral === 0 || primera.total > 0}>
      <p class="vacio__titulo">Ningún prompt dice <span data-vacio-q>«{q}»</span> todavía.</p>
      <p>Prueba con otra palabra, o una más corta.</p>
      <button type="button" class="btn btn--secundario" data-limpiar><Icon name="x" /> Ver todos</button>
    </div>
    <p class="sr-only" aria-live="polite" data-anuncio></p>
  </section>

</Base>

<script>
  import '../scripts/inicio';
  import '../scripts/biblioteca';
</script>

<style>
  /* ================= Intro ================= */
  .intro {
    margin-top: calc(var(--nav-h) * -1);
  }
  .intro__escena {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    height: 100svh;
    min-height: 560px;
    max-height: 980px;
    padding-top: var(--nav-h);
    overflow: hidden;
  }
  .intro__palabra {
    display: flex;
    align-self: center;
    justify-self: center;
    margin: 0;
    font-family: var(--display);
    font-size: clamp(7rem, 28vw, 32rem);
    font-weight: 800;
    line-height: 1;
    color: var(--accent);
  }
  /* Interletrado apretado con márgenes (no letter-spacing) para que el recorte de la entrada no corte los bordes. */
  .intro__letra {
    display: block;
    overflow: clip;
    padding-inline: 0.05em;
    margin-inline: -0.075em;
  }
  .intro__letra > span {
    display: block;
  }

  .intro__base {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: clamp(28px, 5svh, 56px);
  }
  .intro__copy {
    max-width: 34rem;
  }
  h1 {
    font-size: clamp(1.875rem, 3.2vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  h1 span {
    color: var(--muted);
  }
  .intro__copy p {
    margin-top: 12px;
    max-width: 38ch;
    color: var(--muted);
  }

  /* Entrada (solo con animaciones permitidas): las letras suben desde su máscara, luego el texto. */
  :global(.anim) .intro__letra > span {
    animation: subir-letra 1.2s var(--ease) backwards;
    animation-delay: calc(0.1s + var(--i) * 70ms);
  }
  :global(.anim) .intro__base > * {
    animation: aparecer 0.9s var(--ease) backwards;
    animation-delay: 0.6s;
  }
  :global(.anim) .intro__base > * + * {
    animation-delay: 0.7s;
  }
  @keyframes subir-letra {
    from {
      transform: translateY(115%);
    }
  }
  @keyframes aparecer {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  /* ================= Lo más reciente ================= */
  /* Un solo video destacado: texto a la izquierda, video a la derecha (apilado en celular). */
  .reciente {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
    padding-top: clamp(80px, 12vw, 140px);
  }
  .reciente h2 {
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }
  .reciente__texto {
    display: grid;
    justify-items: start;
    gap: 14px;
    max-width: 34rem;
  }
  .reciente__fecha {
    margin-top: 18px;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .reciente__titulo {
    font-family: var(--display);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .reciente__hecho {
    color: var(--muted);
  }
  .reciente__prompt {
    margin: 4px 0 8px;
    padding: 0 16px;
    border-block: 14px solid var(--bg-2);
    border-radius: var(--radius-sm);
    background: var(--bg-2);
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--muted);
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .reciente__media {
    display: block;
    height: min(70svh, 620px);
    max-width: 100%;
    overflow: hidden;
    padding: var(--marco);
    border: 1px solid var(--marco-borde);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--media-shadow);
    transition:
      transform 400ms var(--ease-out),
      border-color 200ms ease;
  }
  .reciente--ancho .reciente__media {
    height: auto;
    width: min(46vw, 640px);
  }
  .reciente__media video {
    width: 100%;
    height: 100%;
    border-radius: calc(var(--radius) - var(--marco));
    object-fit: cover;
  }
  @media (hover: hover) and (pointer: fine) {
    .reciente__media:hover {
      transform: translateY(-4px);
      border-color: color-mix(in oklab, var(--accent) 45%, transparent);
    }
  }
  .reciente__media:active {
    transform: scale(0.98);
    transition-duration: 160ms;
  }

  /* ================= Biblioteca ================= */
  .biblio {
    padding-top: clamp(80px, 10vw, 140px);
  }
  .biblio__cabeza {
    display: grid;
    gap: 28px;
    margin-bottom: 40px;
  }
  .biblio h2 {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }
  .conteo {
    font-family: var(--font);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .buscar {
    display: grid;
    gap: 10px;
    max-width: 640px;
  }
  .buscar label {
    font-weight: 550;
  }
  .buscar__campo {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 60px;
    padding-inline: 22px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg-2);
    color: var(--muted);
    transition:
      border-color 200ms ease,
      box-shadow 200ms ease;
  }
  .buscar__campo :global(.icon) {
    width: 1.3em;
    height: 1.3em;
  }
  .buscar__campo:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 18%, transparent);
  }
  .buscar input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    outline: 0;
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 1.0625rem;
  }
  .buscar input::placeholder {
    color: var(--muted);
  }
  .buscar__ayuda {
    font-size: 0.875rem;
    color: var(--muted);
    max-width: 60ch;
  }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px 20px;
  }

  .vacio {
    display: grid;
    justify-items: start;
    gap: 6px;
    padding: 56px 0;
    color: var(--muted);
  }
  .vacio[hidden] {
    display: none;
  }
  .vacio__titulo {
    font-family: var(--display);
    font-size: 1.5rem;
    font-weight: 650;
    letter-spacing: -0.025em;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .vacio .btn {
    margin-top: 18px;
  }

  /* ================= Responsive ================= */
  @media (max-width: 1099px) {
    .rejilla {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .intro__base {
      flex-direction: column;
      align-items: stretch;
    }
    .reciente,
    .reciente--ancho {
      grid-template-columns: 1fr;
    }
    .reciente__media {
      justify-self: center;
      height: min(64svh, 520px);
    }
    .reciente--ancho .reciente__media {
      width: 100%;
    }
    .rejilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 12px;
    }
  }
</style>
