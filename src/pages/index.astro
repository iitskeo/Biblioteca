---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Tarjeta from '../components/Tarjeta.astro';
import { listar } from '../lib/db';
import { aspecto, esHorizontal, media } from '../lib/site';

const entradas = await listar();
// Video de la intro: el marcado en el panel; si no hay, el vertical más reciente; si no, el más reciente.
const principal = entradas.find((e) => e.portada) ?? entradas.find((e) => !esHorizontal(e.formato)) ?? entradas[0];
const recientes = entradas.slice(0, 6);
const total = entradas.length;

// Texto completo de cada prompt, para mostrar el fragmento donde aparece lo que se busca.
// "<" escapado para que ningún prompt pueda cerrar la etiqueta <script>.
const textos = JSON.stringify(
  Object.fromEntries(entradas.map((e) => [e.id, e.prompts.map((p) => p.texto).join('\n\n')])),
).replace(/</g, '\\u003c');

const letras = [...'itskeo'];
const manifiesto = 'En cada video me preguntan por el prompt. Aquí están todos, completos y listos para copiar.'.split(' ');
---

<Base>
  <!-- Intro: el video se ve a través de las letras; al hacer scroll la cámara las atraviesa. -->
  <section class:list={['intro', { 'intro--sin-video': !principal }]} data-intro>
    <div class="intro__escena">
      {
        principal && (
          <video
            class="intro__video"
            data-intro-video
            data-play="auto"
            muted
            loop
            playsinline
            preload="auto"
            poster={media(principal.poster)}
            aria-hidden="true"
            tabindex="-1"
          >
            <source src={media(principal.video)} type="video/mp4" />
          </video>
        )
      }
      <!-- Tinte menta: las letras siempre se leen aunque el video sea oscuro o tenga logos. -->
      <div class="intro__tinte" data-tinte></div>
      <div class="intro__velo" data-velo></div>

      <div class="intro__mascara" data-mascara aria-hidden="true">
        <span class="intro__palabra" data-palabra>
          {
            letras.map((l) => (
              <span class="intro__letra">
                <span>{l}</span>
              </span>
            ))
          }
        </span>
      </div>
      <!-- Convierte el negro de la máscara en el color exacto de la página (sin "fantasmas" del video). -->
      <div class="intro__fondo" aria-hidden="true"></div>

      <p class="intro__manifiesto wrap" data-manifiesto>
        {manifiesto.map((p) => <span>{p} </span>)}
      </p>

      <div class="intro__base wrap" data-base>
        <div class="intro__copy">
          <h1>Cada video, <span>con su prompt.</span></h1>
          <p>Aquí dejo los prompts exactos de mis videos. Cópialos, juega con ellos y etiquétame con lo que salga.</p>
        </div>
        <a class="btn btn--primario" href="#biblioteca">Ver prompts <Icon name="arrowDown" /></a>
      </div>
    </div>
  </section>

  {
    recientes.length > 0 && (
      <section class="reciente" data-reciente aria-labelledby="reciente-titulo">
        <div class="reciente__fijo">
          <div class="reciente__pista" data-pista>
            <div class="reciente__cabeza">
              <h2 id="reciente-titulo">Lo más reciente</h2>
              <p>Lo último que subí a TikTok, con el prompt listo para copiar.</p>
            </div>
            {recientes.map((e) => (
              <a
                class:list={['reciente__item', { 'reciente__item--ancho': esHorizontal(e.formato) }]}
                href={`/p/${e.id}/`}
                data-hover
              >
                <div class="reciente__media" style={`aspect-ratio: ${aspecto(e.formato)}`}>
                  <video
                    data-play="auto"
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    poster={media(e.poster)}
                    aria-hidden="true"
                    tabindex="-1"
                  >
                    <source src={media(e.video)} type="video/mp4" />
                  </video>
                </div>
                <div class="reciente__info">
                  <h3>
                    {e.titulo}
                    <Icon name="arrowUpRight" />
                  </h3>
                  {e.herramientas.length > 0 && <p>{e.herramientas.join(' + ')}</p>}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section id="biblioteca" class="biblio wrap" aria-labelledby="biblio-titulo">
    <div class="biblio__cabeza" data-revelar>
      <h2 id="biblio-titulo">Todos los prompts <span class="conteo" data-conteo>{total}</span></h2>

      {
        total > 0 && (
          <div class="buscar">
            <label for="q">Busca dentro de los prompts</label>
            <div class="buscar__campo">
              <Icon name="search" />
              <input
                id="q"
                type="search"
                placeholder="nike, 16:9, neón…"
                autocomplete="off"
                spellcheck="false"
                enterkeyhint="search"
                aria-describedby="q-ayuda"
              />
            </div>
            <p id="q-ayuda" class="buscar__ayuda">
              Escribe cualquier palabra que esperas encontrar en el prompt: una marca, un estilo, una proporción.
            </p>
          </div>
        )
      }
    </div>

    {
      total > 0 ? (
        <ul class="rejilla" data-rejilla>
          {entradas.map((e) => (
            <Tarjeta entrada={e} />
          ))}
        </ul>
      ) : (
        <div class="vacio">
          <p class="vacio__titulo">Estoy preparando los primeros prompts.</p>
          <p>Mientras tanto, los videos ya están en TikTok.</p>
        </div>
      )
    }

    <div class="vacio" data-vacio hidden>
      <p class="vacio__titulo">Ningún prompt dice <span data-vacio-q></span> todavía.</p>
      <p>Prueba con otra palabra, o una más corta.</p>
      <button type="button" class="btn btn--secundario" data-limpiar><Icon name="x" /> Ver todos</button>
    </div>
    <p class="sr-only" aria-live="polite" data-anuncio></p>
  </section>

  <script type="application/json" id="textos" set:html={textos} />
</Base>

<script>
  import '../scripts/inicio';
  import '../scripts/biblioteca';
</script>

<style>
  /* ================= Intro ================= */
  .intro {
    position: relative;
    margin-top: calc(var(--nav-h) * -1);
    background: var(--bg);
  }
  /* Con animaciones la sección mide 2.2 pantallas y la escena se queda pegada mientras dura el recorrido. */
  :global(.anim) .intro {
    height: 220svh;
  }
  :global(.anim) .intro--sin-video {
    height: auto;
  }
  .intro__escena {
    position: sticky;
    top: 0;
    isolation: isolate;
    overflow: hidden;
    height: 100svh;
    min-height: 560px;
  }
  .intro__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    /* Dentro de las letras el video es textura: desenfocado y suave. Se aclara al atravesar la "k". */
    filter: blur(14px) saturate(0.75);
  }
  .intro__tinte {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(120% 90% at 30% 20%, color-mix(in oklab, var(--accent) 85%, transparent), transparent 70%),
      linear-gradient(160deg, color-mix(in oklab, var(--accent) 55%, transparent), rgb(13 59 46 / 0.7));
    mix-blend-mode: screen;
    opacity: 0.75;
    pointer-events: none;
  }
  .intro__velo {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    background: linear-gradient(to top, rgb(5 11 9 / 0.8), rgb(5 11 9 / 0.36) 60%, rgb(5 11 9 / 0.2));
    pointer-events: none;
  }

  /* El video solo se ve donde están las letras: negro puro + letras blancas en "multiply"
     (afuera queda negro exacto, sin fuga). Después .intro__fondo, en "lighten", vuelve ese negro
     el color de la página. En modo claro es al revés: blanco + "screen", y luego "darken". */
  .intro__mascara {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    padding-bottom: 14svh;
    background: #000;
    color: #fff;
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .intro__fondo {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--bg);
    mix-blend-mode: lighten;
    pointer-events: none;
  }
  @media (prefers-color-scheme: light) {
    .intro__mascara {
      background: #fff;
      color: #000;
      mix-blend-mode: screen;
    }
    .intro__fondo {
      mix-blend-mode: darken;
    }
  }
  /* Sin video todavía: la palabra se ve sólida en vez de ser una ventana vacía. */
  .intro--sin-video .intro__mascara {
    mix-blend-mode: normal;
    background: var(--bg);
    color: var(--accent);
  }
  .intro__palabra {
    position: relative;
    display: flex;
    font-family: var(--display);
    font-size: clamp(7rem, 28vw, 32rem);
    font-weight: 800;
    line-height: 1;
    will-change: transform;
  }
  /* Interletrado apretado con márgenes (no letter-spacing) para que el recorte de la entrada no corte los bordes. */
  .intro__letra {
    display: block;
    overflow: clip;
    padding-inline: 0.05em;
    margin-inline: -0.075em;
  }
  .intro__letra > span {
    display: block;
  }

  .intro__base {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: clamp(28px, 5svh, 56px);
  }
  .intro__copy {
    max-width: 34rem;
  }
  h1 {
    font-size: clamp(1.875rem, 3.2vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  h1 span {
    color: var(--muted);
  }
  .intro__copy p {
    margin-top: 12px;
    max-width: 38ch;
    color: var(--muted);
  }

  .intro__manifiesto {
    display: none;
  }

  /* Estado inicial de la entrada (solo con animaciones activas, para que no parpadee). */
  :global(.anim) .intro__letra > span {
    transform: translateY(115%);
  }
  :global(.anim) .intro__video,
  :global(.anim) .intro__base > * {
    opacity: 0;
  }
  :global(.anim) .intro__manifiesto {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    gap: 0 0.28em;
    font-family: var(--display);
    font-size: clamp(2.25rem, 5.2vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.04;
    color: #f2f2f0;
    opacity: 0;
    pointer-events: none;
  }
  :global(.anim) .intro__manifiesto span {
    opacity: 0.14;
  }

  /* ================= Lo más reciente ================= */
  .reciente {
    position: relative;
    padding-block: clamp(80px, 12vw, 140px) 24px;
  }
  .reciente__pista {
    display: flex;
    align-items: flex-end;
    gap: clamp(16px, 2vw, 28px);
    padding-inline: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .reciente__pista::-webkit-scrollbar {
    display: none;
  }
  .reciente__cabeza {
    flex: none;
    width: min(30rem, 78vw);
    align-self: center;
    padding-right: clamp(16px, 4vw, 64px);
    scroll-snap-align: start;
  }
  .reciente__cabeza h2 {
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }
  .reciente__cabeza p {
    margin-top: 20px;
    max-width: 30ch;
    color: var(--muted);
  }
  .reciente__item {
    flex: none;
    scroll-snap-align: start;
    width: calc(min(46svh, 440px) * 9 / 16);
  }
  .reciente__item--ancho {
    width: calc(min(34svh, 330px) * 16 / 9);
  }
  .reciente__item:nth-child(odd) {
    margin-bottom: 48px;
  }
  .reciente__media {
    overflow: hidden;
    padding: var(--marco);
    border: 1px solid var(--marco-borde);
    border-radius: var(--radius);
    background: var(--surface);
    transition:
      transform 400ms var(--ease-out),
      border-color 200ms ease;
  }
  .reciente__media video {
    width: 100%;
    height: 100%;
    border-radius: calc(var(--radius) - var(--marco));
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }
  .reciente__info {
    padding-top: 14px;
  }
  .reciente__info p {
    margin-top: 2px;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .reciente__info h3 {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--display);
    font-size: 1.1875rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .reciente__info h3 :global(.icon) {
    color: var(--accent);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition:
      opacity 200ms ease,
      transform 250ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .reciente__item:hover .reciente__media {
      transform: translateY(-6px);
    }
    .reciente__item:hover .reciente__media {
      border-color: color-mix(in oklab, var(--accent) 45%, transparent);
    }
    .reciente__item:hover h3 :global(.icon) {
      opacity: 1;
      transform: none;
    }
  }
  .reciente__item:active .reciente__media {
    transform: scale(0.98);
    transition-duration: 160ms;
  }

  /* Escritorio con animaciones: la sección mide una pantalla más el recorrido horizontal
     (--recorrido lo calcula inicio.ts) y la pista se desliza mientras la escena está pegada. */
  @media (min-width: 768px) {
    :global(.anim) .reciente {
      height: calc(100svh + var(--recorrido, 0px));
      padding-block: 0;
    }
    :global(.anim) .reciente__fijo {
      position: sticky;
      top: 0;
      height: 100svh;
      display: flex;
      align-items: center;
      padding-top: var(--nav-h);
      overflow: hidden;
    }

    :global(.anim) .reciente__pista {
      overflow: visible;
      scroll-snap-type: none;
      will-change: transform;
    }
  }

  /* ================= Biblioteca ================= */
  .biblio {
    padding-top: clamp(80px, 10vw, 140px);
  }
  .biblio__cabeza {
    display: grid;
    gap: 28px;
    margin-bottom: 40px;
  }
  .biblio h2 {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }
  .conteo {
    font-family: var(--font);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .buscar {
    display: grid;
    gap: 10px;
    max-width: 640px;
  }
  .buscar label {
    font-weight: 550;
  }
  .buscar__campo {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 60px;
    padding-inline: 22px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg-2);
    color: var(--muted);
    transition:
      border-color 200ms ease,
      box-shadow 200ms ease;
  }
  .buscar__campo :global(.icon) {
    width: 1.3em;
    height: 1.3em;
  }
  .buscar__campo:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 18%, transparent);
  }
  .buscar input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    outline: 0;
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 1.0625rem;
  }
  .buscar input::placeholder {
    color: var(--muted);
  }
  .buscar__ayuda {
    font-size: 0.875rem;
    color: var(--muted);
    max-width: 60ch;
  }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px 20px;
  }

  .vacio {
    display: grid;
    justify-items: start;
    gap: 6px;
    padding: 56px 0;
    color: var(--muted);
  }
  .vacio[hidden] {
    display: none;
  }
  .vacio__titulo {
    font-family: var(--display);
    font-size: 1.5rem;
    font-weight: 650;
    letter-spacing: -0.025em;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .vacio .btn {
    margin-top: 18px;
  }

  /* ================= Responsive ================= */
  @media (max-width: 1099px) {
    .rejilla {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .intro__base {
      flex-direction: column;
      align-items: stretch;
    }
    .intro__mascara {
      padding-bottom: 30svh;
    }
    .reciente__item {
      width: min(52vw, 240px);
    }
    .reciente__item--ancho {
      width: min(78vw, 360px);
    }
    .reciente__item:nth-child(odd) {
      margin-bottom: 0;
    }
    .rejilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 12px;
    }
  }
</style>
