---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { listar, obtener, type Entrada } from '../../lib/db';
import { aspecto, esHorizontal, fecha, media, vtName } from '../../lib/site';

const entrada = await obtener(Astro.params.id ?? '');
if (!entrada || entrada.borrador) return Astro.rewrite('/404');

const { id, titulo, herramientas, video, poster, formato, prompts, tiktok, sonido, notas, fecha: dia } = entrada;

// Vecinos para seguir explorando: el más antiguo y el más nuevo respecto a este.
const todas = await listar();
const i = todas.findIndex((e) => e.id === id);
const vecinos = [
  todas[i + 1] && { e: todas[i + 1], rotulo: 'Anterior', dir: 'izq' as const },
  todas[i - 1] && { e: todas[i - 1], rotulo: 'Siguiente', dir: 'der' as const },
].filter(Boolean) as { e: Entrada; rotulo: string; dir: 'izq' | 'der' }[];

const parrafos = notas.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const descripcion = `${herramientas.length ? `${herramientas.join(' + ')}. ` : ''}${prompts[0]?.texto ?? ''}`.slice(0, 155);
---

<Base titulo={titulo} descripcion={descripcion} imagen={media(poster)} video={media(video)}>
  <article class:list={['detalle wrap', { 'detalle--ancho': esHorizontal(formato) }]}>
    <div class="detalle__media">
      <div class="player" style={`aspect-ratio: ${aspecto(formato)}; view-transition-name: ${vtName(id)}`}>
        <video data-play="auto" muted loop playsinline preload="auto" poster={media(poster)} data-player>
          <source src={media(video)} type="video/mp4" />
        </video>
        {
          sonido && (
            <button type="button" class="player__sonido" aria-pressed="false" data-sonido>
              <span class="con-sonido">
                <Icon name="soundOn" />
              </span>
              <span class="sin-sonido">
                <Icon name="soundOff" />
              </span>
              <span class="sr-only">Sonido</span>
            </button>
          )
        }
      </div>
    </div>

    <div class="detalle__texto">
      <a class="volver" href="/#biblioteca"><Icon name="arrowLeft" /> Todos los prompts</a>

      <h1>{titulo}</h1>
      <div class="meta">
        <time class="mono" datetime={dia}>{fecha(dia)}</time>
      </div>
      {
        herramientas.length > 0 && (
          <div class="hecho-con">
            <span>Hecho con</span>
            <ul class="herramientas">
              {herramientas.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="prompts">
        {
          prompts.map((p, n) => (
            <section class="prompt" aria-labelledby={`prompt-${n}`}>
              <div class="prompt__cabeza">
                <h2 id={`prompt-${n}`}>{p.etiqueta}</h2>
                <button type="button" class="copiar" data-copiar={`texto-${n}`}>
                  <span class="copiar__normal">
                    <Icon name="copy" /> Copiar
                  </span>
                  <span class="copiar__hecho" aria-hidden="true">
                    <Icon name="check" /> Copiado
                  </span>
                </button>
              </div>
              <pre id={`texto-${n}`}>{p.texto}</pre>
            </section>
          ))
        }
        <p class="consejo">Cópialo tal cual, pégalo en la herramienta y cambia lo que quieras. Si haces algo, etiquétame.</p>
      </div>
      <p class="sr-only" aria-live="polite" data-anuncio></p>

      {
        parrafos.length > 0 && (
          <section class="notas" aria-labelledby="notas-titulo">
            <h2 id="notas-titulo">Cómo lo hice</h2>
            <div class="prosa">
              {parrafos.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </section>
        )
      }

      {
        tiktok && (
          <a class="btn btn--secundario ver-tiktok" href={tiktok} target="_blank" rel="noopener">
            <Icon name="tiktok" /> Ver en TikTok
          </a>
        )
      }
    </div>
  </article>

  {
    vecinos.length > 0 && (
      <nav class="vecinos wrap" aria-label="Más prompts">
        {vecinos.map(({ e, rotulo, dir }) => (
          <a class:list={['vecino', `vecino--${dir}`]} href={`/p/${e.id}/`}>
            {e.poster ? (
              <img src={media(e.poster)} alt="" loading="lazy" decoding="async" width="72" height="128" />
            ) : (
              <span class="vecino__sin-poster" />
            )}
            <span class="vecino__texto">
              <span class="vecino__rotulo">
                {dir === 'izq' && <Icon name="arrowLeft" />}
                {rotulo}
                {dir === 'der' && <Icon name="arrowRight" />}
              </span>
              <span class="vecino__titulo">{e.titulo}</span>
            </span>
          </a>
        ))}
      </nav>
    )
  }
</Base>

<script>
  const anuncio = document.querySelector<HTMLElement>('[data-anuncio]');

  async function copiar(texto: string) {
    try {
      await navigator.clipboard.writeText(texto);
    } catch {
      const area = document.createElement('textarea');
      area.value = texto;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.append(area);
      area.select();
      document.execCommand('copy');
      area.remove();
    }
  }

  for (const boton of document.querySelectorAll<HTMLButtonElement>('[data-copiar]')) {
    let temporizador: number | undefined;
    boton.addEventListener('click', async () => {
      const texto = document.getElementById(boton.dataset.copiar ?? '')?.textContent ?? '';
      await copiar(texto.trim());
      boton.classList.add('hecho');
      if (anuncio) anuncio.textContent = 'Prompt copiado';
      clearTimeout(temporizador);
      temporizador = window.setTimeout(() => boton.classList.remove('hecho'), 1800);
    });
  }

  // Reproductor: tocar el video pausa/reanuda; el botón activa el sonido.
  const player = document.querySelector<HTMLVideoElement>('[data-player]');
  const sonido = document.querySelector<HTMLButtonElement>('[data-sonido]');
  player?.addEventListener('click', () => {
    if (player.paused) {
      delete player.dataset.pausado;
      player.play();
    } else {
      player.dataset.pausado = '1';
      player.pause();
    }
  });
  sonido?.addEventListener('click', () => {
    if (!player) return;
    player.muted = !player.muted;
    if (!player.muted && player.paused) player.play();
    sonido.setAttribute('aria-pressed', String(!player.muted));
  });
</script>

<style>
  .detalle {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: start;
    gap: clamp(32px, 6vw, 96px);
    padding-top: clamp(24px, 4vw, 48px);
  }
  .detalle__media {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
    display: flex;
    justify-content: center;
  }
  .player {
    position: relative;
    height: min(calc(100dvh - var(--nav-h) - 72px), 820px);
    max-width: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow:
      var(--media-shadow),
      inset 0 0 0 1px color-mix(in oklab, var(--text) 8%, transparent);
  }
  /* Videos horizontales: todo apilado (título, video, prompts) a cualquier ancho. */
  .detalle--ancho {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }
  .detalle--ancho .detalle__texto {
    display: contents;
  }
  .detalle--ancho :is(.volver, h1, .meta, .hecho-con) {
    order: -1;
  }
  .detalle--ancho :is(.volver, .ver-tiktok) {
    align-self: flex-start;
  }
  .detalle--ancho .detalle__media {
    position: static;
    margin-top: 32px;
  }
  .detalle--ancho .player {
    height: auto;
    width: min(100%, calc(78dvh * 16 / 9));
  }
  .detalle--ancho :is(.prompts, .notas, .ver-tiktok) {
    order: 1;
    width: 100%;
    max-width: 820px;
  }
  .detalle--ancho .ver-tiktok {
    width: auto;
  }
  .player video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: pointer;
  }
  .player__sonido {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.18);
    background: rgb(12 12 13 / 0.55);
    color: #f2f2f0;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: transform 0.3s var(--ease);
  }
  .player__sonido:active {
    transform: scale(0.94);
  }
  .player__sonido .con-sonido,
  .player__sonido[aria-pressed='true'] .sin-sonido {
    display: none;
  }
  .player__sonido[aria-pressed='true'] .con-sonido {
    display: block;
  }

  .volver {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .volver .icon {
    transition: transform 0.35s var(--ease);
  }
  .volver:hover {
    color: var(--text);
  }
  .volver:hover .icon {
    transform: translateX(-3px);
  }

  h1 {
    margin-top: 28px;
    font-size: clamp(2.5rem, 4.6vw, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
    text-wrap: balance;
  }
  .meta {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }
  .meta time {
    color: var(--muted);
  }
  .hecho-con {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }
  .hecho-con > span {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .herramientas {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .herramientas li {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--surface-2);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .prompts {
    margin-top: 44px;
    display: grid;
    gap: 16px;
  }
  .prompt {
    border-radius: var(--radius);
    transition: border-color 200ms ease;
    background: var(--bg-2);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .prompt__cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 10px 0 20px;
  }
  .prompt h2 {
    font-family: var(--font);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .copiar {
    position: relative;
    display: inline-grid;
    height: 40px;
    padding-inline: 16px;
    border-radius: 999px;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.875rem;
    font-weight: 600;
    transition:
      background-color 200ms ease,
      transform 160ms var(--ease-out);
  }
  .copiar > span {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition:
      opacity 200ms ease,
      filter 200ms ease,
      transform 250ms var(--ease-out);
  }
  /* Cambio de estado con un leve desenfoque: se lee como una sola transformación (Emil). */
  .copiar__hecho {
    opacity: 0;
    filter: blur(2px);
    transform: translateY(6px);
  }
  @media (hover: hover) and (pointer: fine) {
    .copiar:hover {
      background: color-mix(in oklab, var(--accent) 88%, var(--text));
    }
  }
  .copiar:active {
    transform: scale(0.97);
  }
  .copiar.hecho .copiar__normal {
    opacity: 0;
    filter: blur(2px);
    transform: translateY(-6px);
  }
  .copiar.hecho .copiar__hecho {
    opacity: 1;
    filter: none;
    transform: none;
  }
  .consejo {
    margin-top: 4px;
    font-size: 0.875rem;
    color: var(--muted);
  }
  pre {
    margin: 0;
    padding: 16px 20px 22px;
    font-family: var(--mono);
    font-size: 0.875rem;
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--text);
  }

  .notas {
    margin-top: 56px;
    max-width: 62ch;
  }
  .notas h2 {
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .prosa {
    margin-top: 12px;
    color: var(--muted);
  }
  .prosa :global(p + p) {
    margin-top: 1em;
  }
  .prosa :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }
  .prosa :global(code) {
    font-family: var(--mono);
    font-size: 0.875em;
  }
  .ver-tiktok {
    margin-top: 40px;
  }

  .vecinos {
    margin-top: clamp(72px, 10vw, 128px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .vecino {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 12px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    transition:
      background-color 0.25s ease,
      transform 0.35s var(--ease);
  }
  .vecino:hover {
    background: var(--bg-2);
  }
  .vecino:active {
    transform: scale(0.99);
  }
  .vecino--der {
    grid-column: 2;
    flex-direction: row-reverse;
    text-align: right;
  }
  .vecino img {
    width: 48px;
    height: 72px;
    object-fit: cover;
    border-radius: 8px;
    background: var(--surface);
  }
  .vecino__texto {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .vecino__rotulo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .vecino--der .vecino__rotulo {
    justify-content: flex-end;
  }
  .vecino__sin-poster {
    width: 48px;
    height: 72px;
    border-radius: 8px;
    background: var(--surface);
    flex: none;
  }
  .vecino__titulo {
    font-family: var(--display);
    font-weight: 650;
    letter-spacing: -0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Celular: título, luego el video, luego los prompts. */
  @media (max-width: 860px) {
    .detalle {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .detalle__texto {
      display: contents;
    }
    .volver,
    h1,
    .meta,
    .hecho-con {
      order: -1;
    }
    .volver,
    .ver-tiktok {
      align-self: flex-start;
    }
    h1 {
      margin-top: 20px;
    }
    .detalle__media {
      position: static;
      order: 0;
      margin-top: 28px;
    }
    .player {
      height: min(52dvh, 560px);
    }
    .detalle--ancho .player {
      height: auto;
    }
    .prompts,
    .notas,
    .ver-tiktok {
      order: 1;
    }
    .prompts {
      margin-top: 32px;
    }
  }

  @media (max-width: 767px) {
    .vecinos {
      grid-template-columns: 1fr;
    }
    .vecino--der {
      grid-column: auto;
    }
  }
</style>
